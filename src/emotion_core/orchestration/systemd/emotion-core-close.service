[Unit]
Description=Emotion Core Market Close
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/DSH/emotion-core
ExecStart=/home/ubuntu/DSH/emotion-core/.venv/bin/python -c "from emotion_core.orchestration.daily import run_daily; run_daily()"
Environment=PYTHONPATH=/home/ubuntu/DSH/emotion-core/src
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
