[Unit]
Description=Emotion Core Market Close
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/DSH/emotion-core
# ⚠️ 2026-10-07 修正三处，必须走模块入口、不能再用 `python -c`：
#   ① `python -c "…run_daily()"` 把返回值丢在地上 ⇒ run_daily 的失败退出码
#      （1=步骤崩溃 / 76=覆盖率门槛拦截）**全被吞掉**，systemd 永远看到成功。
#      fail-fast 主链死在第 N 步时本 unit 照样 green，与 watchdog 的退出码缺陷
#      一起构成「零告警」的另一半原因。
#   ② `-c` 不经过 `main()` ⇒ 没有 `logging.basicConfig`，journal 里只剩
#      lastResort 打出的 WARNING+。「跑到哪一步 / 非交易日跳过 / 何时 done」
#      全部不可见（daily.py main() 的注释记的就是这个坑）。
#   ③ 环境变量少一行，与 emotion-core-daily.service 不齐。
# 现在与 daily.service 的 ExecStart 完全一致（两条 unit 只差触发时刻）。
ExecStart=/home/ubuntu/DSH/emotion-core/.venv/bin/python -m emotion_core.orchestration.daily
Environment=PYTHONPATH=/home/ubuntu/DSH/emotion-core/src
# 注：DB_CONFIG 目前**没有读取方**（utils/db.py 写死 ~/.dbconfig），此处与
# daily/pool/report/watchdog 四个 unit 保持同形，不代表它能改库连接。
Environment=DB_CONFIG=/home/ubuntu/.dbconfig
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
