[Unit]
Description=Emotion Core Strategy Observer (LLM strategy run)
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/DSH/emotion-core
ExecStart=/home/ubuntu/DSH/emotion-core/.venv/bin/python -m emotion_core.orchestration.strategy
Environment=PYTHONPATH=/home/ubuntu/DSH/emotion-core/src
# 策略观察总闸：不开则 run_for_date 打一条「策略观察已关闭」后返回 0（空转）。
Environment=EC_STRATEGY_ENABLED=true
# 2026-10-09：EC_STRATEGY_MAX_LLM 由 50 抬到 300（20 只 × 15 策略），
# 实测每次 LLM 调用约 7.2s ⇒ 300 次约 36min，1h 余量不足，抬到 2h。
TimeoutStartSec=7200
Nice=10

[Install]
WantedBy=multi-user.target
