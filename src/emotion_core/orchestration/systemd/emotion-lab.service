[Unit]
Description=Emotion Core Lab (panel + baseline scoring, writes lab schema only)
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/DSH/emotion-core
ExecStart=/home/ubuntu/DSH/emotion-core/.venv/bin/python -m emotion_core.lab.runner
Environment=PYTHONPATH=/home/ubuntu/DSH/emotion-core/src
EnvironmentFile=-/home/ubuntu/DSH/emotion-core/deploy/env/emotion-core.env
Nice=10
TimeoutStartSec=1800
