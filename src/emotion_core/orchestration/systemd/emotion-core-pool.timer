[Unit]
Description=Emotion Core EastMoney Limit Pool Sync Timer
Requires=emotion-core-pool.service

[Timer]
# 17:45 北京时间：刻意晚于 daily（17:20）——EM 池是收盘后的当日快照，
# 早于 daily 跑只会拉到半日数据；早于 watchdog（18:05），让当晚的断档检查
# 能看见本轮池同步的结果。
OnCalendar=Mon-Fri 17:45
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
